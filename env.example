# Copy this file to ~/.config/knowledge/env. It is read by the application;
# it is not executed as a shell script. Lines use KEY=VALUE (or export KEY=VALUE).
# System environment variables override values in this file.

# Direct configuration overrides use KB_ + the uppercase TOML key.
# Uncomment and edit as needed:
# KB_WORKSPACE_ROOT=/srv/knowledge/workspace
# KB_PORT=8080
# KB_LLM_PROVIDER=ollama
# KB_MODEL=qwen3:4b

# These provider keys directly override their matching TOML values and can also
# be referenced in TOML with ${OPENAI_API_KEY}, ${GEMINI_API_KEY}, or ${GROQ_API_KEY}.
# OPENAI_API_KEY=replace_with_your_key
# GEMINI_API_KEY=replace_with_your_key
# GROQ_API_KEY=replace_with_your_key
