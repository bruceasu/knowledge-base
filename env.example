# Knowledge Base environment-variable template
# This file is not loaded automatically. Export these variables before starting
# the Java process, then reference them from config.toml with ${ENV_NAME}.

# --- LLM API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Example config.toml references:
# openai_api_key = "${OPENAI_API_KEY}"
# gemini_api_key = "${GEMINI_API_KEY}"
# groq_api_key = "${GROQ_API_KEY}"
