# Modern Authelia v4 example. Replace domains/paths and validate before deployment.
server:
  address: 'tcp://127.0.0.1:9091/'
log:
  level: 'info'
totp:
  issuer: 'Personal Knowledge'
authentication_backend:
  password_reset:
    disable: true
  file:
    path: '/etc/authelia/users_database.yml'
    password:
      algorithm: 'argon2'
access_control:
  default_policy: 'deny'
  rules:
    - domain: 'knowledge.example.com'
      subject: 'user:owner'
      policy: 'two_factor'
session:
  name: 'authelia_session'
  same_site: 'lax'
  inactivity: '5m'
  expiration: '1h'
  remember_me: '-1'
  cookies:
    - domain: 'example.com'
      authelia_url: 'https://auth.example.com'
      default_redirection_url: 'https://knowledge.example.com'
storage:
  local:
    path: '/var/lib/authelia/db.sqlite3'
notifier:
  smtp:
    address: 'submission://smtp.example.com:587'
    username: 'knowledge@example.com'
    sender: 'Knowledge <knowledge@example.com>'
    tls:
      skip_verify: false
# Set these environment variables to restricted secret files outside the workspace:
# AUTHELIA_SESSION_SECRET_FILE
# AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE
# AUTHELIA_NOTIFIER_SMTP_PASSWORD_FILE
